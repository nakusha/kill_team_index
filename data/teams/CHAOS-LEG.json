{
  "id": "CHAOS-LEG",
  "nameEn": "Legionaries",
  "nameKo": "군단병",
  "archetype": "Security/Seek & Destroy",
  "color": "#c49a52",
  "size": {
    "total": 6
  },
  "faction": {
    "id": "CHAOS",
    "nameEn": "Chaos",
    "nameKo": "카오스"
  },
  "ploys": [
    {
      "id": "CHAOS-LEG-S-BFTBG",
      "name": "Blood For The Blood God",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly LEGIONARY operative (excluding KHORNE) is fighting, the first time you strike during that sequence, inflict 1 additional damage (to a maximum of 7).\nAdd 1 to both Dmg stats of friendly LEGIONARY KHORNE operatives’ melee weapons (to a maximum of 7).",
      "textKo": "KHORNE 외 아군 근접전 첫 타격 피해 +1, KHORNE 은 melee Dmg +1"
    },
    {
      "id": "CHAOS-LEG-S-FF",
      "name": "Fickle Fates",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly LEGIONARY operative is shooting a ready enemy operative, that friendly operative’s ranged weapons have the Balanced weapon rule.\nWhenever an operative is shooting a ready friendly LEGIONARY TZEENTCH operative, in the Roll Defence Dice step, if you retain any critical successes, you can retain one of your fails as a normal success instead of discarding it.",
      "textKo": "아군이 ready 적 사격 시 Balanced, TZEENTCH 방어 시 fail 1개를 성공으로"
    },
    {
      "id": "CHAOS-LEG-S-IMP",
      "name": "Implacable",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever an operative is shooting a friendly LEGIONARY operative, weapons with the Piercing 1 weapon rule have the Piercing Crits 1 weapon rule instead.\nYou can ignore any changes to the stats of friendly LEGIONARY NURGLE operatives from being injured (including their weapons’ stats).",
      "textKo": "아군 피격 시 Piercing 1 → Piercing Crits 1, NURGLE 은 injured 무시"
    },
    {
      "id": "CHAOS-LEG-S-QSS",
      "name": "Quicksilver Speed",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly LEGIONARY operative that performed an action in which it moved during this turning point is fighting, worsen the Hit stat of the enemy operative’s melee weapons by 1.\nWhenever an operative is shooting a friendly LEGIONARY SLAANESH operative more than 6\" from it that performed an action in which it moved during this turning point, worsen the Hit stat of the enemy operative’s weapons by 1.\nIn all cases for this ploy, this isn’t cumulative with being injured.",
      "textKo": "이동한 아군과 근접전 시 적 melee Hit 악화, SLAANESH 는 원거리도"
    },
    {
      "id": "CHAOS-LEG-T-MA",
      "name": "Malignant Aura",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly LEGIONARY NURGLE operative is performing the Shoot action, when you select a valid target. Until the end of that action, whenever that friendly operative is shooting an enemy operative within 3\" of it (i.e. including secondary targets, if any), that friendly operative’s ranged weapons have the Piercing 1 weapon rule.",
      "textKo": "아군 NURGLE 사격 시 3\" 이내 대상에게 Piercing 1 획득"
    },
    {
      "id": "CHAOS-LEG-T-MAC",
      "name": "Mutability And Change",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly LEGIONARY TZEENTCH operative is activated. Until the end of that operative’s activation, add 1 to its APL stat, but it cannot perform the same action more than once during that activation. If it’s a WARRIOR operative, that operative’s Marks of Chaos keyword cannot be changed during this turning point (see Infernal Pact additional rule).",
      "textKo": "아군 TZEENTCH 활성화 시 APL +1, 같은 액션 반복 불가"
    },
    {
      "id": "CHAOS-LEG-T-SC",
      "name": "Sickening Captivation",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy during a friendly LEGIONARY SLAANESH operative’s activation, before or after it performs an action. Select one enemy operative visible to and within 4\" of that friendly operative. Until the end of that enemy operative’s next activation, subtract 1 from its APL stat.",
      "textKo": "아군 SLAANESH 활성화 중 4\" 이내 적 1명의 APL 을 다음 활성화까지 -1"
    },
    {
      "id": "CHAOS-LEG-T-UEBS",
      "name": "Unending Bloodshed",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly LEGIONARY KHORNE operative is incapacitated while fighting or retaliating. You can strike the enemy operative in that sequence with one of your unresolved successes before it’s removed from the killzone.",
      "textKo": "아군 KHORNE 이 근접전/반격 중 무력화될 때 제거 전 1회 타격"
    }
  ],
  "equipment": [
    {
      "id": "CHAOS-LEG-WA",
      "name": "Warded Armour",
      "textEn": "STRATEGIC GAMBIT. Select one friendly LEGIONARY operative. Until the Ready step of the next Strategy phase, change that operative’s Save stat to 2+.",
      "textKo": "GAMBIT, 아군 1명의 Save 를 다음 Ready 단계까지 2+ 로"
    },
    {
      "id": "CHAOS-LEG-MB",
      "name": "Malefic Blades",
      "textEn": "Friendly LEGIONARY operatives have the following melee weapon:\nNAME ATK HIT DMG\nMalefic blade 5 3+ 3/4",
      "textKo": "전원에게 말레픽 블레이드 (A5 · H3+ · D3/4)"
    },
    {
      "id": "CHAOS-LEG-TR",
      "name": "Tainted Rounds",
      "textEn": "Once per turning point, when a friendly LEGIONARY operative is performing the Shoot action and you select a bolt pistol or boltgun, you can use this rule. If you do, until the end of that action, that weapon has the Rending weapon rule.",
      "textKo": "TP당 1회, 볼트 피스톨 · 볼트건에 Rending"
    },
    {
      "id": "CHAOS-LEG-CT",
      "name": "Chaos Talismans",
      "textEn": "STRATEGIC GAMBIT. Select one Marks of Chaos keyword. Once during each of their activations, when a friendly LEGIONARY operative that has that keyword is shooting, fighting or retaliating, if you roll two or more fails, you can inflict D3 damage on that friendly operative to discard one of them and retain the other as a normal success instead. Note that if it’s the Shoot action and that damage incapacitates that friendly operative, the action doesn’t end (continue the sequence with your successful attack dice).",
      "textKo": "GAMBIT, Marks of Chaos 키워드 1개 선택 — 실패 2개 이상 시 D3 자해하고 재굴림"
    }
  ],
