  "size": {
    "total": 5
  },
  "faction": {
    "id": "ASTA",
    "nameEn": "Space Marines",
    "nameKo": "스마"
  },
  "ploys": [
    {
      "id": "IMP-DW-S-MT",
      "name": "Mission Tactics",
      "type": "strategy",
      "cp": 1,
      "textEn": "Select Conceal or Engage. Whenever a friendly DEATHWATCH operative is shooting against or fighting against an enemy operative that has that order, that friendly operative’s weapons have the Balanced weapon rule.",
      "textKo": "Conceal/Engage 선택, 그 order 의 적 상대 아군 무기가 Balanced"
    },
    {
      "id": "IMP-DW-S-TLV",
      "name": "The Long Vigil",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever an operative is shooting a friendly DEATHWATCH operative that’s wholly within your territory, you can re-roll one of your defence dice.",
      "textKo": "아군 진영 안의 아군이 피격 시 방어 주사위 1개 재굴림"
    },
    {
      "id": "IMP-DW-S-TSTS",
      "name": "The Shield That Slays",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly DEATHWATCH operative is wholly within your opponent’s territory, Normal Dmg of 4 or more inflicts 1 less damage on it.",
      "textKo": "적 진영 안의 아군은 4 이상 Normal Dmg 를 1 감소"
    },
    {
      "id": "IMP-DW-S-ATSKNF",
      "name": "And They Shall Know No Fear",
      "type": "strategy",
      "cp": 1,
      "textEn": "You can ignore any changes to the stats of friendly DEATHWATCH operatives from being injured (including their weapons’ stats).",
      "textKo": "아군 DEATHWATCH 가 부상으로 인한 스탯 변화를 무시"
    },
    {
      "id": "IMP-DW-T-SNTA",
      "name": "Suffer Not The Alien",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy after rolling your attack dice for a friendly DEATHWATCH operative, if it’s shooting against or fighting against an operative that doesn’t have the CHAOS or IMPERIUM keyword. You can re-roll any of your attack dice.",
      "textKo": "CHAOS/IMPERIUM 아닌 적을 공격 시 Atk 주사위 재굴림"
    },
    {
      "id": "IMP-DW-T-AT",
      "name": "Auspicator Tracking",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly DEATHWATCH operative is counteracting, before it performs any actions. You can change its order.",
      "textKo": "아군이 counteract 할 때 행동 전에 order 를 변경"
    },
    {
      "id": "IMP-DW-T-AAS",
      "name": "Advanced Auspex Scan",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly DEATHWATCH operative performs the Shoot action. Until the end of the activation/ counteraction, its ranged weapons have the Saturate weapon rule and enemy operatives cannot be obscured.",
      "textKo": "사격 시 아군 사격 무기가 Saturate 획득, 적은 obscured 불가"
    },
    {
      "id": "IMP-DW-T-THP",
      "name": "Transhuman Physiology",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when an operative is shooting a friendly DEATHWATCH operative, in the Roll Defence Dice step. You can retain one of your normal successes as a critical success instead.",
      "textKo": "아군 피격 시 방어 Normal 성공 1개를 Critical 성공으로"
    }
  ],
  "equipment": [
    {
      "id": "IMP-DW-DW",
      "name": "Digital Weapons",
      "textEn": "Once per turning point, when a friendly DEATHWATCH operative performs the Fight action, at the start of the Roll Attack Dice step, you can use this rule. If you do, inflict 1 damage on the enemy operative in that sequence.",
      "textKo": "TP당 1회, Fight 시 공격 주사위를 굴리기 전에 적에게 1 피해"
    },
    {
      "id": "IMP-DW-SST",
      "name": "Scrutavore Servo-Thrall",
      "textEn": "Once per turning point, during a friendly DEATHWATCH operative’s activation, you can use this rule. If you do, during that activation, that operative can perform a mission action for 1 less AP.\nHaving an enemy operative within its control range doesn’t prevent that friendly operative from performing that mission action. However, in such an instance, after it does so, you and your opponent roll-off. If your opponent wins, you cannot use this equipment for the rest of the battle.",
      "textKo": "TP당 1회, 미션 액션 1AP 감소. 적 통제 범위 안에서도 가능하나 이후 롤오프"
    },
    {
      "id": "IMP-DW-SVBSC",
      "name": "Sanctus-V Bioscryer Cuffs",
      "textEn": "Once during each friendly DEATHWATCH operative’s activation, before or after it performs an action, if it’s not within control range of enemy operatives, you can use this rule. If you do, select one of the following:\n• That friendly operative regains up to D3 lost wounds.\n• Remove any changes to that friendly operative’s APL stat.\n• Remove one of the following tokens that friendly operative has (before that token’s activation effects are resolved, if relevant): Neutron Fragment, Poison, Terrorchem.",
      "textKo": "활성화 중 1회, D3 상처 회복 · APL 변화 제거 · 토큰 1개 제거 중 선택"
    },
    {
      "id": "IMP-DW-AR",
      "name": "Ammunition Reserve",
      "textEn": "Once per battle, you can use the Special Issue Ammunition faction rule for up to two Shoot actions during one turning point, but you must select different weapon rules for both uses. This takes precedence over the normal Special Issue Ammunition rules.",
      "textKo": "전투당 1회, 한 TP 에 Special Issue Ammunition 을 2회까지 (규칙은 서로 다르게)"
    }
  ],
  "equipmentBonusKo": "Watch Sergeant 를 데려가면 장비를 하나 더 고를 수 있습니다",
