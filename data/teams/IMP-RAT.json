  "ploys": [
    {
      "id": "IMP-RAT-S-CS",
      "name": "Crack Shots",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly RATLING operative is shooting an enemy operative more than 6\" from it, if that friendly operative hasn’t performed the Charge, Fall Back or Reposition action during the activation, or if it’s a counteraction, its rifle (if any) has the Balanced weapon rule. Note that operative isn’t restricted from performing those actions after shooting.",
      "textKo": "이동 없이 6\" 초과 적 사격 시 아군 RATLING rifle 이 Balanced"
    },
    {
      "id": "IMP-RAT-S-FA",
      "name": "Frontline Assault",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly RATLING BULLGRYN or friendly RATLING OGRYN operative within your opponent’s territory or within 3\" of an objective marker is shooting, fighting or retaliating, its weapons have the Balanced weapon rule.",
      "textKo": "적 진영·목표 마커 3\" 내에서 OGRYN/BULLGRYN 무기가 Balanced"
    },
    {
      "id": "IMP-RAT-S-SH",
      "name": "Shifty",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly RATLING operative (excluding OGRYN or BULLGRYN) has a Conceal order and is in cover, it cannot be selected as a valid target, taking precedence over all other rules (e.g. Seek, Vantage terrain) except being within 2\".",
      "textKo": "Conceal 이고 Cover 안인 아군 RATLING 은 대상 지정 불가"
    },
    {
      "id": "IMP-RAT-S-SP",
      "name": "Sniper Positions",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly RATLING operative is more than 6\" from enemy operatives and within 1\" of Heavy terrain, the stationary profile of its rifle (if any) has the Silent weapon rule.",
      "textKo": "적 6\" 밖 + Heavy 지형 통제 시 rifle Stationary 가 Silent"
    },
    {
      "id": "IMP-RAT-T-LAR",
      "name": "Larcenous",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy during a friendly RATLING operative’s activation (excluding OGRYN or BULLGRYN). Until the end of that activation, that operative doesn’t have to control a marker to perform the Pick Up Marker or mission actions that usually require this (this takes precedence over that action’s conditions – it only needs to contest the marker), and having an enemy operative within its control range doesn’t prevent it from doing so.",
      "textKo": "활성화 동안 마커를 contest 만 해도 Pick Up·미션 행동 가능"
    },
    {
      "id": "IMP-RAT-T-SS",
      "name": "Sharpshot",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly RATLING operative is performing the Shoot action with a rifle and you’re selecting a valid target. Having other friendly RATLING operatives within an enemy operative’s control range doesn’t prevent that enemy operative from being selected.",
      "textKo": "rifle 사격 시 적 통제 범위 안의 아군 무시하고 대상 지정"
    },
    {
      "id": "IMP-RAT-T-SAH",
      "name": "Shoot And Hide",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy after a friendly RATLING operative that has an Engage order performs the Shoot action with a rifle. If it’s more than 3\" from enemy operatives, or not visible to every enemy operative, you can change its order to Conceal.",
      "textKo": "rifle 사격 후 적 3\" 밖이면 order 를 Conceal 로 변경"
    },
    {
      "id": "IMP-RAT-T-SI",
      "name": "Survival Instincts",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when an enemy operative is shooting against or fighting against a friendly RATLING operative (excluding OGRYN or BULLGRYN) and you’re allocating a dice to block. If it’s a normal success, it can block one unresolved critical success; if it’s a critical success, it can block two unresolved successes (normal or critical).",
      "textKo": "방어 시 Normal 이 크리티컬 1개, 크리티컬이 성공 2개를 block"
    }
  ],
  "equipment": [
    {
      "id": "IMP-RAT-PR",
      "name": "Purloined Rations",
      "textEn": "Once per turning point, when a friendly RATLING operative is shooting with a rifle and you’ve rolled your attack dice, you can use this rule. If you do, improve the Hit stat of its rifle by 1 until the end of that sequence. This can allow you to apply the Hit stat change during an action (this takes precedence over the core rules).",
      "textKo": "TP당 1회, 라이플 공격 주사위를 굴린 뒤 Hit +1"
    },
    {
      "id": "IMP-RAT-LR",
      "name": "Lucky Round",
      "textEn": "Once per turning point, when a friendly RATLING operative is shooting with a rifle and you’ve rolled your attack dice, you can use this rule. If you do, that weapon has the Severe weapon rule until the end of that sequence.",
      "textKo": "TP당 1회, 라이플 사격에 Severe 부여"
    },
    {
      "id": "IMP-RAT-SG",
      "name": "Stolen Goods",
      "textEn": "At the end of the Select Operatives step, roll one D3. If the result is:\n• 1, you lose 1CP.\n• 2, you gain 1CP.\n• 3, your opponent loses 1CP.",
      "textKo": "요원 선택 후 D3 — 1 내 CP −1 · 2 내 CP +1 · 3 상대 CP −1"
    },
    {
      "id": "IMP-RAT-IA",
      "name": "Improvised Armour",
      "textEn": "Whenever an operative is shooting a friendly RATLING BULLGRYN or friendly RATLING OGRYN operative, defence dice results of 5+ are critical successes.",
      "textKo": "BULLGRYN · OGRYN 이 사격받을 때 방어 주사위 5+ 가 크리티컬"
    }
  ],
  "equipmentBonusKo": "Ratling Fixer 를 데려가면 장비를 하나 더 고를 수 있습니다",
