    "nameKo": "오크"
  },
  "ploys": [
    {
      "id": "ORK-KOM-S-DD",
      "name": "DAKKA! DAKKA! DAKKA!",
      "type": "strategy",
      "cp": 1,
      "textEn": "Friendly KOMMANDO operatives’ ranged weapons have the Punishing weapon rule.",
      "textKo": "아군 KOMMANDO 사격 무기가 Punishing 획득"
    },
    {
      "id": "ORK-KOM-S-SA",
      "name": "Skulk About",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever an enemy operative is shooting a friendly KOMMANDO operative that has a Conceal order, you can retain one of your defence dice as a normal success without rolling it (in addition to a cover save, if any).",
      "textKo": "Conceal 아군이 사격당할 때 방어 주사위 1개 굴림 없이 Normal 성공"
    },
    {
      "id": "ORK-KOM-S-SHHH",
      "name": "SSSSHHHH!",
      "type": "strategy",
      "cp": 1,
      "textEn": "Each friendly KOMMANDO operative that’s not a valid target for enemy operatives, or has a Conceal order and is more than 6\" from enemy operatives, can immediately perform a free Dash action. You cannot use this ploy during the first turning point.",
      "textKo": "유효 목표가 아닌 아군들이 무료 Dash (TP1 제외)"
    },
    {
      "id": "ORK-KOM-S-WAAGH",
      "name": "WAAAGH!",
      "type": "strategy",
      "cp": 1,
      "textEn": "Friendly KOMMANDO operatives’ melee weapons have the Balanced weapon rule.",
      "textKo": "아군 KOMMANDO 근접 무기가 Balanced 획득"
    },
    {
      "id": "ORK-KOM-T-JAS",
      "name": "Just A Scratch",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when an attack dice inflicts Normal Dmg on a friendly KOMMANDO operative (excluding BOMB SQUIG and GROT). Ignore that inflicted damage.",
      "textKo": "아군이 Normal Dmg 를 받을 때 그 피해를 무시"
    },
    {
      "id": "ORK-KOM-T-KE",
      "name": "Krump 'Em",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy at the end of the Firefight phase. Select one friendly KOMMANDO operative. It can immediately perform a free Fight action.",
      "textKo": "Firefight 페이즈 종료 시 아군 1명이 무료 Fight"
    },
    {
      "id": "ORK-KOM-T-KBB",
      "name": "Kunnin' But Brutal",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly KOMMANDO operative that has a Conceal order is fighting during an activation in which it performed the Charge action, you’re resolving the first attack dice, and it’s a strike with a normal success. Treat that normal success as a critical success instead.",
      "textKo": "Conceal 아군이 Charge 후 근접전 시 첫 Normal 성공을 크리티컬로"
    },
    {
      "id": "ORK-KOM-T-SIO",
      "name": "Shake It Off",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly KOMMANDO operative is activated, or when its APL stat is changed. Until the start of the next turning point, you can ignore any changes to its APL stat.",
      "textKo": "아군의 APL 변경을 다음 TP 시작까지 무시"
    }
  ],
  "equipment": [
    {
      "id": "ORK-KOM-CHP",
      "name": "Choppas",
      "textEn": "Friendly KOMMANDO operatives (excluding BOMB SQUIG and GROT) have the following melee weapon. Note that some operatives already have this weapon but with better stats; in that instance, use the better version.\nNAME ATK HIT DMG\nChoppa 3 3+ 4/5",
      "textKo": "전원에게 초파 (A3 · H3+ · D4/5), BOMB SQUIG · GROT 제외"
    },
    {
      "id": "ORK-KOM-CS",
      "name": "Collapsible Stocks",
      "textEn": "Remove the Range weapon rule from the following ranged weapons friendly KOMMANDO operatives have:\n• Shokka pistol\n• Slugga",
      "textKo": "쇼카 피스톨과 슬러가에서 Range 규칙 제거"
    },
    {
      "id": "ORK-KOM-DYN",
      "name": "Dynamite",
      "textEn": "Once per battle, a friendly KOMMANDO operative (excluding BOMB SQUIG and GROT) can use the following ranged weapon:\nNAME ATK HIT DMG\nDynamite 5 4+ 4/5\nWR\nRange 4\", Blast 1\", Heavy (Reposition only), Saturate",
      "textKo": "전투당 1회 다이너마이트 (A5 · H4+ · D4/5, Rng 4\" · Blast 1\" · Heavy)"
    },
    {
      "id": "ORK-KOM-HRP",
      "name": "Harpoon",
      "textEn": "Once per turning point, a friendly KOMMANDO operative (excluding BOMB SQUIG and GROT) can use the following ranged weapon:\nNAME ATK HIT DMG\nHarpoon 4 4+ 4/5\nWR\nRange 8\", Lethal 5+, Stun",
      "textKo": "TP당 1회 하푼 (A4 · H4+ · D4/5, Rng 8\" · Lethal 5+ · Stun)"
    }
  ],
