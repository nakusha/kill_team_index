  "selectionGuide": {
    "brief": "침투 · 섬멸 — 편성 1+9 = 10명",
    "blocks": [
      {
        "type": "rule",
        "text": "ARCHETYPES: INFILTRATION, SEEK & DESTROY"
      },
      {
        "type": "heading",
        "text": "OPERATIVES"
      },
      {
        "type": "rule",
        "text": "↘ 1 KOMMANDO BOSS NOB operative with one of the following options:\n• Slugga; big choppa\n• Slugga; power klaw"
      },
      {
        "type": "rule",
        "text": "↘ 9 KOMMANDO operatives selected from the following list:\n• BOMB SQUIG\n• BOY\n• BREACHA BOY\n• BURNA BOY\n• COMMS BOY\n• DAKKA BOY\n• GROT\n• ROKKIT BOY\n• SLASHA BOY\n• SNIPA BOY"
      },
      {
        "type": "rule",
        "text": "Other than BOY operatives, your kill team can only include each operative on this list once."
      },
      {
        "type": "rule",
        "text": "These operatives count as half a selection each, meaning you can select both of them and it's treated as one selection in total."
      }
    ]
  },
  "factionRule": {
    "brief": "THROAT SLITTAS",
    "blocks": [
      {
        "type": "heading",
        "text": "THROAT SLITTAS"
      },
      {
        "type": "lore",
        "text": "Unusual amongst Orks, Kommandos utilise stealth and misdirection to close in before falling upon the enemy with jagged blades drawn."
      },
      {
        "type": "rule",
        "text": "Each friendly KOMMANDO operative (excluding BOMB SQUIG) can perform the Charge action while it has a Conceal order."
      }
    ]
  },
  "source": "공식 Kill Team 앱 PDF 추출본"
}
