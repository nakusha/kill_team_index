  "ploys": [
    {
      "id": "IMP-INB-S-AO",
      "name": "Attack Order",
      "type": "strategy",
      "cp": 1,
      "textEn": "Place your Attack Order marker in the killzone. Whenever a friendly IMPERIAL NAVY BREACHER operative within 3\" of that marker is shooting, fighting or retaliating, its weapons have the Ceaseless weapon rule. In the Ready step of the next Strategy phase, remove that marker. You cannot use this ploy and the Defence Order strategy ploy during the same Strategy phase.",
      "textKo": "Attack Order 마커 배치, 3\" 내 아군 무기가 Ceaseless 획득"
    },
    {
      "id": "IMP-INB-S-BFCA",
      "name": "Brace For Counterattack",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever an operative is shooting against, fighting against or retaliating against a friendly IMPERIAL NAVY BREACHER operative that’s within your territory or that hasn’t performed the Charge, Fall Back or Reposition action during this turning point, Normal and Critical Dmg of 3 or more inflicts 1 less damage on that friendly operative.",
      "textKo": "내 영역에 있거나 이동 안 한 아군은 3 이상 Dmg 를 1 줄임"
    },
    {
      "id": "IMP-INB-S-CA",
      "name": "Close Assault",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly IMPERIAL NAVY BREACHER operative is fighting or shooting an operative within 3\" of it:\n• Add 1 to both Dmg stats of all profiles of its Navis shotguns or Navis heavy shotguns (if any).\n• If you roll two or more fails, you can discard one of them to retain another as a normal success instead.",
      "textKo": "3\" 내 적 공격 시 Navis 샷건 Dmg +1, 실패 2개 중 1개를 성공으로"
    },
    {
      "id": "IMP-INB-S-DO",
      "name": "Defence Order",
      "type": "strategy",
      "cp": 1,
      "textEn": "Place your Defence Order marker in the killzone. Whenever an operative is shooting a friendly IMPERIAL NAVY BREACHER operative that’s within 3\" of that marker, you can re-roll any of your defence dice results of one result (e.g. results of 2). In the Ready step of the next Strategy phase, remove that marker. You cannot use this ploy and the Attack Order strategy ploy during the same Strategy phase.",
      "textKo": "Defence Order 마커 배치, 3\" 내 아군 피격 시 방어 주사위 재굴림"
    },
    {
      "id": "IMP-INB-T-BL",
      "name": "Blitz",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly IMPERIAL NAVY BREACHER operative performs the Shoot or Fight action, and you select an enemy operative within 6\" of it as a valid target or to fight against. If it’s the first friendly operative to perform either of those actions during this turning point, its weapons have the Accurate 1 weapon rule for that action. If it’s the first friendly operative to be activated during this turning point, its weapons also have the Severe weapon rule for that action.",
      "textKo": "6\" 내 적 공격 시 TP 첫 공격이면 Accurate 1, 첫 활성화면 Severe"
    },
    {
      "id": "IMP-INB-T-DH",
      "name": "Deck Hand",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy during a friendly IMPERIAL NAVY BREACHER operative’s activation, before or after it performs an action. That operative can move through one Accessible terrain feature without it counting as an additional 1\" and/or perform a free Operate Hatch action during its activation, and can do so during the Charge or Fall Back action. You cannot use this ploy if the access point has been welded shut (see HATCHCUTTER) unless it’s a friendly HATCHCUTTER operative’s activation.",
      "textKo": "활성화 중 Accessible 지형 무료 통과 또는 무료 Operate Hatch"
    },
    {
      "id": "IMP-INB-T-LID",
      "name": "Lock it Down",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly IMPERIAL NAVY BREACHER operative is activated. Select one objective marker. Until the end of the battle or until you use this ploy again (whichever comes first), when determining control of that objective marker, treat that friendly operative’s APL stat as 1 higher. Note this isn’t a change to the APL stat, so any changes are cumulative with this.",
      "textKo": "목표 마커 1개 선택, 그 마커 통제 시 아군 APL 을 1 높게 취급"
    },
    {
      "id": "IMP-INB-T-OT",
      "name": "Overwhelm Target",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when you activate either friendly IMPERIAL NAVY BREACHER operative while using the Breach and Clear faction rule. Until the end of that operative’s activation, add 1 to its APL stat.",
      "textKo": "Breach and Clear 로 활성화할 때 아군 1명이 APL +1"
    }
  ],
  "equipment": [
    {
      "id": "IMP-INB-RB",
      "name": "Rebreathers",
      "textEn": "You can ignore any changes to the APL stat of friendly IMPERIAL NAVY BREACHER operatives, and they aren’t affected by enemy operatives’ Shock weapon rule.",
      "textKo": "APL 변화를 무시하고 적의 Shock 규칙에 영향받지 않음"
    },
    {
      "id": "IMP-INB-SL",
      "name": "Slugs",
      "textEn": "Up to three times per turning point, whenever a friendly IMPERIAL NAVY BREACHER operative is performing the Shoot action and you select a Navis shotgun (long range), you can use this rule. If you do, until the end of that action, improve the Hit stat of that weapon by 1 and add 1 to both of its Dmg stats.",
      "textKo": "TP당 3회, navis shotgun(long range) 의 Hit +1 및 Dmg +1"
    },
    {
      "id": "IMP-INB-CS",
      "name": "Combat Stimms",
      "textEn": "You can ignore any changes to the Move stat of friendly IMPERIAL NAVY BREACHER operatives from being injured.",
      "textKo": "부상으로 인한 Move 변화를 무시"
    },
    {
      "id": "IMP-INB-SORD",
      "name": "System Override Device",
      "textEn": "Once per turning point, one friendly IMPERIAL NAVY BREACHER operative can perform the Operate Hatch action for 1 less AP.",
      "textKo": "TP당 1회, Operate Hatch 액션을 1AP 적게"
    }
  ],
