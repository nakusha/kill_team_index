  "ploys": [
    {
      "id": "TAU-XV26-PH",
      "name": "Patient Hunters",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly XV26 STEALTH BATTLESUIT operative is shooting against or fighting against an expended enemy operative, that friendly operative’s weapons have the Balanced weapon rule and its ranged weapons have the Saturate weapon rule.",
      "textKo": "소진된 적을 공격할 때 균형, 원거리 무기는 포화까지 획득"
    },
    {
      "id": "TAU-XV26-BOU",
      "name": "Bonds of Unity",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly XV26 STEALTH BATTLESUIT operative is activated (excluding DRONE), if it's visible to and within 6\" of another friendly XV26 STEALTH BATTLESUIT operative (excluding DRONE), you can ignore any changes to that first friendly operative's APL stat and select one of the following:\n• Ignore any changes to that first friendly operative’s Move stat from being injured until the end of that activation.\n• Ignore any changes to the Hit stat of that first friendly operative’s weapons from being injured until the end of that activation.",
      "textKo": "다른 아군 6\" 시야 내면 APL 변경 무시 + 이동·명중 부상 효과 무시"
    },
    {
      "id": "TAU-XV26-PA",
      "name": "Prepare Ambush",
      "type": "strategy",
      "cp": 1,
      "textEn": "Place one of your Ambush markers wholly within your territory and more than 2\" from enemy operatives. Whenever a friendly XV26 STEALTH BATTLESUIT operative is shooting an enemy operative that’s within 2\" of that marker, you can use this rule. If you do, that friendly operative's ranged weapons have the Seek weapon rule until the end of the action. Remove that Ambush marker at the end of that action or in the Ready step of the next turning point (whichever comes first).",
      "textKo": "매복 마커 배치 — 2\" 내 적을 사격하면 마커를 쓰고 색적 획득"
    },
    {
      "id": "TAU-XV26-HWCM",
      "name": "Holowave Countermeasures",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever an operative is shooting a friendly XV26 STEALTH BATTLESUIT operative more than 6\" from it, in the Roll Attack Dice step, the attacker must discard one of their unresolved normal successes (or one of their critical successes if there are none). This isn’t cumulative with being obscured.",
      "textKo": "6\" 밖에서 사격당하면 공격자가 성공 주사위 하나를 버려야 한다"
    },
    {
      "id": "TAU-XV26-VRT",
      "name": "Vectored Retro-Thrusters",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when an enemy operative ends the Charge action within control range of a friendly XV26 STEALTH BATTLESUIT operative (excluding DRONE). Interrupt that action to use this rule. If you do, that friendly operative can immediately perform a free Fall Back action, but it cannot move more than 3\" during that action. Then, that enemy operative can immediately perform a free Reposition action using any remaining move distance it had from that first Charge action, and can do so even if it’s performed an action that prevents it from performing the Reposition action.",
      "textKo": "적이 장악 범위에서 돌격을 마치면 방해하고 3\" 후퇴, 적은 기동"
    },
    {
      "id": "TAU-XV26-GS",
      "name": "Ghostshroud",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy at the end of a friendly XV26 STEALTH BATTLESUIT operative’s activation. If that operative has an Engage order, change it to Conceal. You cannot use this ploy for each friendly operative more than once per battle.",
      "textKo": "운용 종료 시 교전 명령을 은폐로 변경 (요원당 전투 1회)"
    },
    {
      "id": "TAU-XV26-EJP",
      "name": "Engage Jet Pack",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly XV26 STEALTH BATTLESUIT operative (excluding DRONE) is activated or counteracts. Until the end of that activation/counteraction, you can ignore the vertical distance they move during one climb and one drop.",
      "textKo": "운용·대응 동안 올라가기와 내려가기의 수직 이동을 각 1회 무시"
    },
    {
      "id": "TAU-XV26-SP",
      "name": "Saviour Protocols",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly XV26 STEALTH BATTLESUIT operative (excluding DRONE) is selected as the valid target of a Shoot action. Select one friendly XV26 STEALTH BATTLESUIT DRONE operative visible to and within 3\" of that first friendly operative to become the valid target instead (even if it wouldn’t normally be valid for this). That friendly DRONE operative is only in cover or obscured if the original target was. This ploy has no effect if the ranged weapon has the Blast or Torrent weapon rule.",
      "textKo": "사격 대상이 되면 3\" 내 드론 아군을 대신 대상으로 (폭발·격류 제외)"
    }
  ],
  "equipment": [
    {
      "id": "TAU-XV26-MT",
      "name": "XV26 Multitrackers",
      "textEn": "Once per turning point, when a friendly XV26 STEALTH BATTLESUIT operative is performing the Shoot action and you select a burst cannon (sweeping), you can use this rule. If you do, until the end of that action, that weapon has the Torrent 2\" weapon rule.",
      "textKo": "전환점당 1회, 작렬포(소사) 사격에 격류 2\" 부여"
    },
    {
      "id": "TAU-XV26-CNJ",
      "name": "Counter-Network Jammers",
      "textEn": "STRATEGIC GAMBIT. Select one objective marker or mission marker. Until the end of the turning point, whenever determining control of that marker, treat the total APL stat of enemy operatives that contest it as 1 lower if at least one of those enemy operatives is within 3\" of friendly XV26 STEALTH BATTLESUIT operatives. Note this isn’t a change to the APL stat, so any changes are cumulative with this.",
      "textKo": "전략 포석 — 마커 하나, 3\" 내 적들의 APL 합계를 -1 로 간주"
    },
    {
      "id": "TAU-XV26-ABSF",
      "name": "Advanced Blacksun Filters",
      "textEn": "Whenever a friendly XV26 STEALTH BATTLESUIT operative is shooting an operative that's obscured, you don't have to discard one success as a result of that rule. All other effects of obscured apply as normal.",
      "textKo": "차폐된 적을 사격할 때 성공 주사위를 버리지 않아도 된다"
    },
    {
      "id": "TAU-XV26-HWTL",
      "name": "Hardwired Target Locks",
      "textEn": "Whenever you would counteract, you can do so with one friendly XV26 STEALTH BATTLESUIT operative that has a Conceal order and is more than 3\" from enemy operatives, but before it counteracts, you must change its order to Engage and it cannot perform any actions other than Shoot during that counteraction.",
      "textKo": "은폐 명령이고 적 3\" 밖이면 대응 가능 — 교전으로 바꾸고 사격만"
    }
  ],
