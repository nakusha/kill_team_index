  "id": "IMP-AOD",
  "nameEn": "Angels Of Death",
  "nameKo": "죽음의 천사",
  "archetype": "Security/Seek & Destroy",
  "color": "#4f82cc",
  "size": {
    "total": 6
  },
  "faction": {
    "id": "ASTA",
    "nameEn": "Space Marines",
    "nameKo": "스마"
  },
  "ploys": [
    {
      "id": "IMP-AOD-S-ADT",
      "name": "Adaptive Tactics",
      "type": "strategy",
      "cp": 1,
      "textEn": "Change your secondary CHAPTER TACTIC. Note this ploy only lasts until the end of the turning point, at which point your original secondary CHAPTER TACTIC returns.",
      "textKo": "2차 챕터 전술을 이번 전환점 동안 다른 것으로 변경"
    },
    {
      "id": "IMP-AOD-S-ATSKNF",
      "name": "And They Shall Know No Fear",
      "type": "strategy",
      "cp": 1,
      "textEn": "You can ignore any changes to the stats of friendly ANGEL OF DEATH operatives from being injured (including their weapons’ stats).",
      "textKo": "부상으로 인한 능력치 변경을 무시 (무기 수치 포함)"
    },
    {
      "id": "IMP-AOD-S-CD",
      "name": "Combat Doctrine",
      "type": "strategy",
      "cp": 1,
      "textEn": "Select one COMBAT DOCTRINE from those presented below. Whenever a friendly ANGEL OF DEATH operative is x, its weapons have the Balanced weapon rule. X is the COMBAT DOCTRINE you selected.\n• Devastator Doctrine: Shooting an operative more than 6\" from it.\n• Tactical Doctrine: Shooting an operative within 6\" of it.\n• Assault Doctrine: Fighting or retaliating.",
      "textKo": "교리 하나를 선택 — 해당 상황에서 아군 무기가 균형 획득"
    },
    {
      "id": "IMP-AOD-S-IND",
      "name": "Indomitus",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever an operative is shooting a friendly ANGEL OF DEATH operative, if you roll two or more fails, you can discard one of them to retain another as a normal success instead.",
      "textKo": "사격당할 때 실패 2개 이상이면 하나를 일반 성공으로 보전"
    },
    {
      "id": "IMP-AOD-T-ADJT",
      "name": "Adjust Doctrine",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy during a friendly ANGEL OF DEATH operative’s activation, before or after it performs an action. If you’ve used the Combat Doctrine strategy ploy during this turning point, change the COMBAT DOCTRINE you selected.",
      "textKo": "아군 운용 중, 이번 전환점에 고른 전투 교리를 바꾼다"
    },
    {
      "id": "IMP-AOD-T-SA",
      "name": "Shock Assault",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly ANGEL OF DEATH operative is performing the Fight action during an activation in which it performed the Charge action, at the start of the Resolve Attack Dice step. Until the end of that action:\n• Its melee weapon has the Shock weapon rule.\n• The first time you strike during that sequence, inflict 1 additional damage (to a maximum of 7).",
      "textKo": "돌격 후 근접전 시 근접 무기에 충격 부여, 첫 타격 피해 +1"
    },
    {
      "id": "IMP-AOD-T-TP",
      "name": "Transhuman Physiology",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when an operative is shooting a friendly ANGEL OF DEATH operative, in the Roll Defence Dice step. You can retain one of your normal successes as a critical success instead.",
      "textKo": "사격당할 때 방어 일반 성공 하나를 결정적 성공으로 보전"
    },
    {
      "id": "IMP-AOD-T-WOV",
      "name": "Wrath Of Vengeance",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly ANGEL OF DEATH operative is counteracting. It can perform an additional 1AP action for free during that counteraction, but both actions must be different.",
      "textKo": "대응 도중 1AP 행동 하나를 무상으로 추가 (다른 행동이어야 함)"
    }
  ],
  "equipment": [
    {
      "id": "IMP-AOD-CR",
      "name": "Chapter Reliquaries",
      "textEn": "You can use the Wrath of Vengeance firefight ploy for 0CP if the specified friendly operative has an Engage order.",
      "textKo": "복수의 분노 사용 시 그 요원이 교전 명령이면 0CP 로 사용"
    },
    {
      "id": "IMP-AOD-PS",
      "name": "Purity Seals",
      "textEn": "Once per turning point, when a friendly ANGEL OF DEATH operative is shooting, fighting or retaliating, if you roll two or more fails, you can discard one of them to retain another as a normal success instead.",
      "textKo": "전환점당 1회, 실패 2개 이상이면 하나를 일반 성공으로 보전"
    },
    {
      "id": "IMP-AOD-TS",
      "name": "Tilting Shields",
      "textEn": "Once per turning point, when a friendly ANGEL OF DEATH operative is fighting or retaliating, after your opponent rolls their attack dice, but before re-rolls, you can use this rule. If you do, your opponent cannot retain attack dice results of less than 6 as critical successes during that sequence (e.g. as a result of the Lethal, Rending or Severe weapon rules).",
      "textKo": "전환점당 1회, 근접 방어 시 상대는 6 미만을 결정적 성공으로 보전 불가"
    },
    {
      "id": "IMP-AOD-AUS",
      "name": "Auspex",
      "textEn": "Once per turning point, when a friendly ANGEL OF DEATH operative performs the Shoot action and you’re selecting a valid target, you can use this rule. If you do, until the end of the activation/ counteraction, enemy operatives within 8\" of that friendly operative cannot be obscured.",
      "textKo": "전환점당 1회, 운용이 끝날 때까지 8\" 내 적은 차폐될 수 없음"
    }
  ],
