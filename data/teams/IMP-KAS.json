  "ploys": [
    {
      "id": "IMP-KAS-S-CS",
      "name": "Clearance Sweep",
      "type": "strategy",
      "cp": 1,
      "textEn": "Place your Clearance Sweep marker in the killzone. Whenever a friendly KASRKIN operative within 5\" horizontally of that marker is shooting an operative also within 5\" horizontally of that marker, that friendly operative’s weapons have the Ceaseless weapon rule. In the Ready step of the next Strategy phase, remove that marker.",
      "textKo": "마커 배치, 마커 5\" 내 KASRKIN 이 5\" 내 적 사격 시 Ceaseless"
    },
    {
      "id": "IMP-KAS-S-EP",
      "name": "Elimination Pattern",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly KASRKIN operative is shooting with a hot-shot weapon against an operative that cannot retain any cover saves or is being scanned (see RECON-TROOPER), that weapon has the Piercing Crits 1 weapon rule, or Piercing 1 instead if it’s a hot-shot volley gun.",
      "textKo": "Cover Save 불가/scanned 대상 사격 시 hot-shot 이 Piercing Crits 1"
    },
    {
      "id": "IMP-KAS-S-EFC",
      "name": "Engage From Cover",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever an operative is shooting a friendly KASRKIN operative that’s in cover, you can re-roll one of your defence dice.",
      "textKo": "Cover 안 아군 KASRKIN 이 사격당할 때 방어 주사위 1개 재굴림"
    },
    {
      "id": "IMP-KAS-S-REL",
      "name": "Relocate",
      "type": "strategy",
      "cp": 1,
      "textEn": "Select one friendly KASRKIN operative that’s more than 3\" from enemy operatives. That operative, and each other friendly KASRKIN operative that’s both within 3\" of that operative and more than 3\" from enemy operatives, can immediately perform a free Dash action in an order of your choice. You cannot use this ploy during the first turning point.",
      "textKo": "적에게서 3\" 밖 아군 KASRKIN 1명과 그 3\" 내 아군들이 무료 Dash"
    },
    {
      "id": "IMP-KAS-T-CR",
      "name": "Cover Retreat",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly KASRKIN operative performs the Fall Back action while visible to and within 6\" of another friendly KASRKIN operative that’s not within control range of enemy operatives. After that friendly operative has finished moving, but before that Fall Back action ends, that other friendly operative can immediately perform a free Shoot action (you can change its order to Engage to do so).",
      "textKo": "아군이 Fall Back 할 때 6\" 내 다른 아군 KASRKIN 이 무료 사격"
    },
    {
      "id": "IMP-KAS-T-GNG",
      "name": "Give No Ground",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy during a friendly KASRKIN operative’s activation, or at the end of the Firefight phase. Select one of your mission markers or an objective marker. Until the end of that activation or until the start of the next turning point respectively, if the total APL of friendly KASRKIN operatives that contest that marker is 2, and the total APL of enemy operatives that contest it is the same, friendly KASRKIN operatives control that marker.",
      "textKo": "마커 1개 선택, APL 동점이어도 아군 KASRKIN 이 그 마커 통제"
    },
    {
      "id": "IMP-KAS-T-NT",
      "name": "Neutralise Target",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy after rolling your attack dice for a friendly KASRKIN operative, if it’s shooting an operative that either cannot retain any cover saves or is being scanned (see RECON-TROOPER). You can re-roll any of your attack dice.",
      "textKo": "Cover Save 불가/scanned 대상 사격 후 공격 주사위 재굴림"
    },
    {
      "id": "IMP-KAS-T-STI",
      "name": "Seize The Initiative",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy at the start of the Firefight phase. One friendly KASRKIN operative can immediately perform a 1AP action for free, but it cannot move during that action. You cannot use this ploy if you’re the player with initiative.",
      "textKo": "Firefight 단계 시작에 아군 1명이 1AP 행동 무료 (이동 불가)"
    }
  ],
  "equipment": [
    {
      "id": "IMP-KAS-FG",
      "name": "Foregrip",
      "textEn": "Whenever a friendly KASRKIN operative is shooting an operative within 3\" of it, ranged weapons on its datacard (excluding weapons that include ‘pistol’ in their name, e.g. hot-shot laspistol, all profiles of a plasma pistol, etc.) have the Accurate 1 weapon rule.",
      "textKo": "3\" 안 사격 시 데이터카드의 원거리 무기(피스톨 제외)에 Accurate 1"
    },
    {
      "id": "IMP-KAS-LRS",
      "name": "Long-Range Scope",
      "textEn": "Whenever a friendly KASRKIN operative is shooting an operative more than 6\" from it, that friendly operative’s hot-shot weapons have the Saturate weapon rule.",
      "textKo": "6\" 밖 사격 시 hot-shot 무기에 Saturate"
    },
    {
      "id": "IMP-KAS-ROC",
      "name": "Relics Of Cadia",
      "textEn": "Once per turning point, when a friendly KASRKIN operative is shooting, fighting or retaliating, if you roll two or more fails, you can discard one of them to retain another as a normal success instead.",
      "textKo": "TP당 1회, 실패 2개 이상이면 하나 버리고 다른 하나를 성공으로"
    },
    {
      "id": "IMP-KAS-CD",
      "name": "Combat Daggers",
      "textEn": "Friendly KASRKIN operatives have the following melee weapon:\nNAME ATK HIT DMG\nCombat dagger 3 4+ 3/4",
      "textKo": "전원에게 컴뱃 대거 (A3 · H4+ · D3/4)"
    }
  ],
