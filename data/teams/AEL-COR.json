  "selectionGuide": {
    "brief": "침투 · 정찰 — 편성 1+8 = 9명",
    "blocks": [
      {
        "type": "rule",
        "text": "ARCHETYPES: INFILTRATION, RECON"
      },
      {
        "type": "heading",
        "text": "OPERATIVES"
      },
      {
        "type": "rule",
        "text": "↘ 1 CORSAIR VOIDSCARRED FELARCH operative with one of the following options:\n• Shuriken rifle; shuriken pistol; power weapon\n• Neuro disruptor; power weapon"
      },
      {
        "type": "rule",
