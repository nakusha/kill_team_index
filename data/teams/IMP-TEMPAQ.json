    "nameKo": "임페리움"
  },
  "ploys": [
    {
      "id": "IMP-TEMPAQ-S-DAS",
      "name": "Drop And Secure",
      "type": "strategy",
      "cp": 1,
      "textEn": "Select one marker.\n• Until the Ready step of the next Strategy phase, when determining control of that marker, treat the total APL stat of friendly TEMPESTUS AQUILON operatives that contest it as 1 higher if at least one friendly TEMPESTUS AQUILON operative contests that marker. Note this isn’t a change to the APL stat, so any changes are cumulative with this.\n• Whenever a friendly TEMPESTUS AQUILON operative is within 3\" of that marker, add 1 to the Atk stat of its melee weapons (to a maximum of 4).",
      "textKo": "마커 하나 — 경합 시 APL 합계 +1, 3\" 내 아군 근접 공격 +1"
    },
    {
      "id": "IMP-TEMPAQ-S-EA",
      "name": "Eye Above",
      "type": "strategy",
      "cp": 1,
      "textEn": "Select one enemy operative. That operative and each other enemy operative within 3\" of it gains one of your Detected tokens until the end of the turning point. Whenever an enemy operative that has one of your Detected tokens:\n• Is shooting a friendly TEMPESTUS AQUILON operative, you can re‑roll one of your defence dice.\n• Is fighting or retaliating against a friendly TEMPESTUS AQUILON operative, one of your blocks can be allocated to block two unresolved successes (instead of one).",
      "textKo": "적 하나와 3\" 내 적에게 탐지됨 토큰 — 그 적의 공격에 방어가 유리"
    },
    {
      "id": "IMP-TEMPAQ-S-MM",
      "name": "Maintain Momentum",
      "type": "strategy",
      "cp": 1,
      "textEn": "Whenever a friendly TEMPESTUS AQUILON operative is shooting against or fighting against a ready enemy operative, that friendly operative’s weapons have the Severe weapon rule.",
      "textKo": "준비 상태인 적을 공격할 때 아군 무기가 중상 획득"
    },
    {
      "id": "IMP-TEMPAQ-S-SO",
      "name": "Sudden Offensive",
      "type": "strategy",
      "cp": 1,
      "textEn": "Count the number of friendly TEMPESTUS AQUILON operatives that aren’t incapacitated, then halve the result (rounding up) to give you x. Until the end of their activation, friendly TEMPESTUS AQUILON operatives’ weapons have the Balanced weapon rule if they are the first friendly operatives activated this turning point equal to x. For example, if you have five operatives, the first three friendly operatives activated will benefit.",
      "textKo": "이번 전환점 먼저 운용하는 아군 절반(올림)의 무기가 균형 획득"
    },
    {
      "id": "IMP-TEMPAQ-T-AC",
      "name": "Adjust Coordinates",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly TEMPESTUS AQUILON operative lands. You can set it up within 5\" horizontally of one of your Drop markers, taking precedence over the normal distance requirement. It cannot perform the Dash, Shoot or Fight actions during this turning point.",
      "textKo": "착지 시 강하 마커에서 5\" 내에 배치. 이번 전환점 행동 제한"
    },
    {
      "id": "IMP-TEMPAQ-T-HD",
      "name": "Hot Drop",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy after rolling your attack dice for a friendly TEMPESTUS AQUILON operative that’s wholly within your opponent’s territory, or either landed or dropped from Vantage terrain at least 2\" higher than the killzone floor during this activation. If the target is within 6\" of it, you can re‑roll any of your attack dice.",
      "textKo": "상대 영역·착지·고지 강하 후 6\" 내 대상이면 공격 주사위 재굴림"
    },
    {
      "id": "IMP-TEMPAQ-T-PRO",
      "name": "Progena",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy when a friendly TEMPESTUS AQUILON operative (excluding SERVO‑SENTRY) is activated. It regains up to 2D3 lost wounds, and during that activation you can ignore any changes to its APL stat.",
      "textKo": "운용 시작 시 2D3 체력 회복, 그 운용 동안 APL 변경 무시"
    },
    {
      "id": "IMP-TEMPAQ-T-TE",
      "name": "Tempestus Exemplars",
      "type": "firefight",
      "cp": 1,
      "textEn": "Use this firefight ploy during a friendly TEMPESTUS AQUILON operative’s activation (excluding SERVO‑SENTRY and any operative that has an APL stat higher than 2). During that activation, that operative can perform the Pick Up Marker, Place Marker or a mission action for 1 less AP.",
      "textKo": "운용 중 마커 회수·배치와 임무 행동의 AP 를 1 줄인다"
    }
  ],
  "equipment": [
    {
      "id": "IMP-TEMPAQ-TD",
      "name": "Tempestus Daggers",
      "textEn": "Friendly TEMPESTUS AQUILON operatives (excluding SERVO‑SENTRY) have the following melee weapon:\nNAME ATK HIT DMG\nTempestus dagger 3 4+ 3/4",
      "textKo": "서보센트리 외 전원이 템페스투스 단검 (공격3 명중4+ 피해3/4)"
    },
    {
      "id": "IMP-TEMPAQ-CS",
      "name": "Combat Stimms",
      "textEn": "You can ignore any changes to the Move stat of friendly TEMPESTUS AQUILON operatives from being injured.",
      "textKo": "부상으로 인한 이동 수치 변경을 무시"
    },
    {
      "id": "IMP-TEMPAQ-DA",
      "name": "Drop Augury",
      "textEn": "Once per battle, when a friendly TEMPESTUS AQUILON operative that’s set up above is activated, before expending or landing that operative, you can move one of your Drop markers again. However, it cannot be moved closer to your opponent’s drop zone.",
      "textKo": "전투당 1회, 상공의 아군이 운용될 때 강하 마커를 다시 이동"
    },
    {
      "id": "IMP-TEMPAQ-ROS",
      "name": "Remote Overseer",
      "textEn": "Once per battle, after rolling off to decide initiative, you can re‑roll your dice.",
      "textKo": "전투당 1회, 선제권 롤오프 주사위를 재굴림"
    }
  ],
