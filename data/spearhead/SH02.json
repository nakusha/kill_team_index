    },
    {
      "group": "레지먼트 어빌리티",
      "timing": "아무 턴 종료시",
      "name": "적들을 몰아붙여라",
      "declare": "교전 중이며, 점령에 참여중인 아군 유닛을 원하는 만큼 선택한다.",
      "effect": "해당 유닛들은 파일인 이동을 수행한다. (15.3 참조) 파일인 이동을 수행한 뒤, 1\" 이내의 적 유닛을하나 선택해 주사위를 하나 굴린다. 굴림값 4+로 대상적 유닛이게 1 모탈 대미지의 피해를 입힌다.\""
    },
    {
      "group": "레지먼트 어빌리티",
      "timing": "패시브",
      "name": "마지막까지 버텨라",
      "declare": "",
      "effect": "아군 유닛들은 자신이 소유한 오브젝트 점령에 참여중이라면, 와드(6+)를 얻는다."
    },
    {
      "group": "인핸스먼트",
      "timing": "패시브",
      "name": "최고의 사냥꾼",
      "declare": "",
      "effect": "괴수를 대상으로 한 텐가바르의 대미지 수치는 4 대신, 2D6이 된다."
    },
    {
      "group": "인핸스먼트",
      "timing": "게임 당 한번, 자신의 이동 페이즈",
      "name": "눈부신 광휘",
      "declare": "이번 페이즈에 배치된 아군 지휘관을 선택한다.",
      "effect": "지휘관 12\" 이내의 각 아군 유닛들은 제거된 모델을하나씩 복귀시킨다."
    },
    {
      "group": "인핸스먼트",
      "timing": "패시브",
      "name": "폭풍우의 분노",
      "declare": "",
      "effect": "지휘관은 돌격한 턴에 스트라이크-퍼스트 효과를받는다."
    },
    {
      "group": "인핸스먼트",
