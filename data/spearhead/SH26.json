    {
      "group": "아미 특성",
      "timing": "패시브",
      "name": "아미 규칙",
      "declare": "",
      "effect": "아이언블라스터와 마운팽 팩. 오거 글루톤 한 유닛은 배치 페이즈에 전장에 배치하지 않는다. 대신, 3 배틀 라운드\n이후로 다음의 능력을 사용해 전장에 배치할 수 있다."
    },
    {
      "group": "아미 특성",
      "timing": "자신의 이동 페이즈",
      "name": "꼬르륵 소리가 울려퍼지는 도착",
      "declare": "",
      "effect": "이 유닛을 전장 3” 이내에 들어가며, 적 6” 바깥에 위치하게끔 배치한다."
    },
    {
      "group": "레지먼트 어빌리티",
      "timing": "게임 당 한번, 아무 돌격 페이즈",
      "name": "허리띠 풀어헤치고",
      "declare": "이번 페이즈에 돌격한 아군 유닛을 원하는 만큼선택한다.",
      "effect": "해당 유닛마다 교전 중인 적 유닛을 하나 선택해 주사위를 하나 굴린다. 굴림값 4+마다, 대상 유닛에게 1 모탈 대미지를 입힌다."
    },
    {
      "group": "레지먼트 어빌리티",
      "timing": "패시브",
      "name": "튼튼한 교잡종",
      "declare": "",
      "effect": "아군 아이언블라스터와 마운팽 팩 유닛은 체력 수치에 +1"
    },
    {
      "group": "인핸스먼트",
      "timing": "패시브",
      "name": "큰 성큼걸음",
      "declare": "",
      "effect": "지휘관의 이동 수치는 6” 대신 8”가 된다."
    },
    {
      "group": "인핸스먼트",
      "timing": "아무 컴뱃 페이즈",
      "name": "터져나오는 포효",
      "declare": "",
      "effect": "주사위를 하나 굴려, 굴림값 4+로 지휘관 9” 이내의적 유닛들이 가하는 공격은 명중 굴림값에 -1"
    },
    {
      "group": "인핸스먼트",
      "timing": "게임 당 한번, 리액션: 지휘관이 어택의 대상이 될 때",
      "name": "스톤혼 피가 담긴 병",
      "declare": "",
      "effect": "지휘관은 이번 페이즈 동안 와드(5+)를 가진다."
    },
    {
      "group": "인핸스먼트",
      "timing": "게임 당 한번, 아무 이동 페이즈",
      "name": "블러버글럽",
